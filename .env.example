# Published release image. Override only to pin another release.
USDB_IMAGE=ghcr.io/nschmidtdev/usdb-importer:0.1.2

# Docker web authentication (required)
USDB_USERNAME=change-me
USDB_PASSWORD=replace-with-a-long-random-password

# Safe default: only expose the service on this computer.
# Use 0.0.0.0 only behind an HTTPS reverse proxy.
USDB_BIND_ADDRESS=127.0.0.1
